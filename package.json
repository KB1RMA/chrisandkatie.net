{
	"name": "chrisandkatiedotnet",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.8.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"type:check": "tsc --noEmit",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"build:open-next": "opennextjs-cloudflare build",
		"db:generate": "drizzle-kit generate",
		"db:migrate:d1": "wrangler d1 migrations apply prisma-demo-db --remote --env production",
		"db:migrate:local": "wrangler d1 migrations apply prisma-demo-db-local --local",
		"db:seed": "tsx scripts/import-guests.ts",
		"db:seed:d1": "tsx scripts/import-guests.ts --remote --env production",
		"db:seed:local": "tsx scripts/import-guests.ts --local",
		"db:seed:test-data": "wrangler d1 execute prisma-demo-db-local --local --file tests/fixtures/test-data.sql",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.9.0",
		"@hookform/resolvers": "^5.2.2",
		"@opennextjs/cloudflare": "^1.19.1",
		"@tanstack/react-table": "^8.21.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/leaflet": "^1.9.21",
		"@types/qrcode": "^1.5.6",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"leaflet": "^1.9.4",
		"next": "16.2.3",
		"next-auth": "^5.0.0-beta.30",
		"partysocket": "^1.1.16",
		"pino": "^10.3.1",
		"qrcode": "^1.5.4",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-hook-form": "^7.72.1",
		"react-leaflet": "^5.0.0",
		"react-photo-album": "^3.5.1",
		"resend": "^6.10.0",
		"tailwind-merge": "^3.5.0",
		"tsx": "^4.21.0",
		"yet-another-react-lightbox": "^3.31.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/jsdom": "^28.0.1",
		"@types/node": "^25.9.0",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.56.1",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.6",
		"@vitest/eslint-plugin": "^1.6.17",
		"@vitest/ui": "^4.0.18",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.3",
		"eslint-config-next": "^16.2.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.10.3",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-testing-library": "^7.16.2",
		"jsdom": "^29.1.1",
		"partykit": "^0.0.115",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"vitest-github-actions-reporter": "^0.11.1",
		"wrangler": "^4.92.0"
	},
	"optionalDependencies": {
		"@emnapi/core": "^1.9.2",
		"@emnapi/runtime": "^1.9.2"
	}
}
