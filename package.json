{
	"name": "chrisandkatiedotnet",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.8.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"postinstall": "prisma generate",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:migrate:apply": "sqlite3 prisma/dev.db < prisma/migrations/$(ls -t prisma/migrations | head -1)/migration.sql",
		"db:setup": "rm -f prisma/dev.db* && sqlite3 prisma/dev.db < prisma/migrations/$(ls -t prisma/migrations | head -1)/migration.sql && npm run db:seed",
		"db:seed": "tsx scripts/import-guests.ts",
		"db:seed:remote": "tsx scripts/import-guests.ts --remote",
		"db:studio": "prisma studio",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.1",
		"@hookform/resolvers": "^5.2.2",
		"@opennextjs/cloudflare": "^1.16.5",
		"@prisma/adapter-d1": "^7.4.1",
		"@prisma/client": "^7.4.1",
		"classnames": "^2.5.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.3.1",
		"next": "16.1.6",
		"next-auth": "^5.0.0-beta.30",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.71.2",
		"tsx": "^4.21.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@prisma/adapter-libsql": "^7.4.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^25.3.0",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"@typescript-eslint/eslint-plugin": "^8.56.0",
		"@typescript-eslint/parser": "^8.56.0",
		"better-sqlite3": "^12.6.2",
		"eslint": "^9.39.3",
		"eslint-config-next": "^16.1.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"prettier": "^3.8.1",
		"prisma": "^7.4.1",
		"tailwindcss": "^4",
		"typescript": "^5.9.3",
		"wrangler": "^4.67.0"
	}
}
