# Environment Variables Template
# Copy this file to .env.local for local development

# Database URL for local SQLite development
DATABASE_URL="file:./prisma/dev.db"

# Auth.js / NextAuth.js configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# R2 photo storage — base URL for serving guest photo booth uploads.
# Local dev: point to the wrangler dev proxy route.
# Production: set to your R2 custom domain (e.g. https://photo-booth.yourdomain.com).
R2_PUBLIC_BASE_URL="http://localhost:8787/api/photo-booth/files"

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_ID="your-github-client-id"
# GITHUB_SECRET="your-github-client-secret"
