# Environment Variables Template
# Copy this file to .env.local for local development

# Database URL for local SQLite development
DATABASE_URL="file:./prisma/dev.db"

# Auth.js / NextAuth.js configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# R2 photo storage — base URL for serving guest photo booth uploads.
# Local dev: point to the wrangler dev proxy route.
# Production: set to your R2 custom domain (e.g. https://photo-booth.yourdomain.com).
R2_PUBLIC_BASE_URL="http://localhost:8787/api/photo-booth/files"

# CARTO Basemaps API key — used client-side by the schedule/lodging Leaflet
# maps for the warm "Voyager" tile style. Free, domain-restricted key from
# https://carto.com/basemaps/apikey/. Prefixed NEXT_PUBLIC_ so Next.js inlines
# it into the browser bundle at build time (this is expected: the key is
# restricted to the registered domain, the same model as a Google Maps key).
# Omit it and maps fall back to plain OpenStreetMap tiles.
NEXT_PUBLIC_CARTO_API_KEY="your-carto-api-key"

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_ID="your-github-client-id"
# GITHUB_SECRET="your-github-client-secret"
