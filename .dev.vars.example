# Load .env.development* files when running `wrangler dev`
NEXTJS_ENV=development

# Admin credentials — used as First Name / Last Name in the existing login form.
# Set these to log in as admin and access /admin/* pages.
ADMIN_USERNAME=your_admin_first_name
ADMIN_PASSWORD=your_admin_password

# RSVP email notification settings
# Required for the RSVP notification queue consumer to send emails via Resend.
# Obtain an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The email address that receives RSVP notification emails
OWNER_EMAIL=owner@example.com

# R2 public URL used to construct photo URLs after upload.
# In local dev, this proxies through the Next.js file route so photos are
# accessible without a public CDN domain.
R2_PUBLIC_BASE_URL=http://localhost:8787/api/photo-booth/files
